# Server
HOST=0.0.0.0
PORT=8001

# AI API key — set this to your own key
API_KEY=your_gemini_api_key_here

# Models
GEMINI_MODEL=gemini-2.5-flash
VISION_MODEL=gemini-2.0-flash
VISION_FALLBACK_MODELS=gemini-1.5-flash,gemini-1.5-pro

# Supabase JWT secret (Project Settings → API → JWT Secret)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local development only — never enable in production
ALLOW_UNAUTHENTICATED=false

# Rate limiting (per user)
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=3600
