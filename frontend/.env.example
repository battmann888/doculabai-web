# Frontend environment variables
# The backend API base URL (default: http://localhost:8000)
# In development (npm run dev), set this to your backend URL.
VITE_API_BASE_URL=http://localhost:8000

# Optional Supabase auth (leave empty to run without authentication)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
