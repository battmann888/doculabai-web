# Frontend environment variables
# The backend API base URL.
# - If set, this value is used as-is (e.g. https://api.doculabai.my.id).
# - If left empty:
#     * In development (npm run dev): falls back to http://localhost:8000
#     * In production (Vercel): falls back to the relative path "/api",
#       so requests hit the same domain as the frontend (e.g. https://doculabai.my.id/api).
# Leave empty when the backend is served from the same domain as the frontend.
VITE_API_BASE_URL=


# Optional Supabase auth (leave empty to run without authentication)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
